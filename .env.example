# ── Connection mode ──────────────────────────────────────────────────────────
#   session — (default) saves login to SESSION_DIR; log in once, never again
#   login   — auto-login with credentials below each run
#   cdp     — attach to Chrome with --remote-debugging-port=9222
DICE_MODE=session

# ── Session profile directory ─────────────────────────────────────────────────
# Change this to switch Dice accounts — each account needs its own folder
SESSION_DIR=~/.dice-playwright-profile

# ── Credentials (only needed when DICE_MODE=login) ───────────────────────────
DICE_EMAIL=your@email.com
DICE_PASSWORD=yourpassword

# ── CDP port (only needed when DICE_MODE=cdp) ────────────────────────────────
CDP_URL=http://localhost:9222

# ── Search settings ───────────────────────────────────────────────────────────
# Job title / keyword to search for
SEARCH_QUERY=gen ai

# How recently the job was posted:
#   ONE    = today / last 24 hours
#   THREE  = last 3 days
#   SEVEN  = last 7 days
#   THIRTY = last 30 days
#   (leave blank for any time)
POSTED_DATE=ONE

# true = Easy Apply jobs only | false = all jobs
EASY_APPLY=true
